NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Supabase Auth + client (same project for localhost + production)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_anon_or_publishable_key
# Fallback only (browser uses window.location.origin). Set on Railway to your public URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
#
# Supabase Dashboard → Authentication → URL Configuration — add BOTH:
#   http://localhost:3000/auth/callback
#   https://marketbiqsfrontend-production.up.railway.app/auth/callback
# Site URL can be the production frontend URL.
# Built-in signup email is capped (~2/hour). Use custom SMTP for production,
# or temporarily disable “Confirm email” under Auth → Providers → Email.
